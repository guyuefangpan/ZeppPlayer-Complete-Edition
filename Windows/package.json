{
  "name": "zeppplayer",
  "version": "1.8.15",
  "description": "Unofficial ZeppOS emulator",
  "main": "electron_main.js",
  "scripts": {
    "browser:build": "esbuild --bundle --outdir=app src/index.browser.js",
    "cli:build": "esbuild --bundle --platform=node --external:canvas --outdir=app src/index.cli.js",
    "browser:watch": "esbuild --bundle --outdir=app src/index.browser.js --watch",
    "build": "npm run browser:build && npm run cli:build",
    "dist:x64": "npm run browser:build && electron-builder --win --x64",
    "dist:ia32": "npm run browser:build && electron-builder --win --ia32",
    "dist": "npm run browser:build && electron-builder --win --x64 --ia32"
  },
  "build": {
    "appId": "com.zeppplayer.desktop",
    "productName": "ZeppPlayer",
    "directories": {
      "output": "release"
    },
    "files": [
      "app/**/*",
      "projects/**/*",
      "electron_main.js",
      "preload.js",
      "package.json",
      "assets/**/*",
      "!**/node_modules/**"
    ],
    "npmRebuild": false,
    "win": {
      "icon": "assets/icon.ico",
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        }
      ]
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "ZeppPlayer"
    }
  },
  "bin": {
    "zepp-preview": "app/index.cli.js"
  },
  "repository": {
    "type": "git",
    "url": "https://notabug.org/melianmiko/ZeppPlayer"
  },
  "author": "MelianMiko",
  "license": "Apache 2.0",
  "dependencies": {
    "@types/node": "^20.10.5",
    "buffer": "^6.0.3",
    "canvas": "^2.11.2",
    "file-saver": "^2.0.5",
    "fs": "^0.0.1-security",
    "mini-signals": "^2.0.0"
  },
  "devDependencies": {
    "@types/uuid": "^9.0.7",
    "electron": "^44.4.2",
    "electron-builder": "^26.15.3",
    "esbuild": "^0.19.10",
    "gif-encoder-2": "^1.0.5",
    "normalize-path": "^3.0.0",
    "path-normalize": "^6.0.12",
    "preact": "^10.19.3",
    "tga": "^1.0.7",
    "uuid": "^9.0.1",
    "yargs": "^17.7.2"
  }
}
